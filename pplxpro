#!/usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK

import argparse
import os
import requests
import colorama
from colorama import Fore, Style
import argcomplete

API_KEY = "Add-Your-API-Keys-Here"
API_URL = "https://api.perplexity.ai/chat/completions"

MODELS = [
    "sonar-small-online",
    "sonar-medium-online",
    "sonar-small-chat",
    "sonar-medium-chat",
    "mistral-7b-instruct",
    "llama-3.1-sonar-small-128k-online",
    "llama-3.1-sonar-large-128k-online",
    "sonar-pro",
    "gpt-4-omni",
    "claude-3.5-sonnet",
    "gemini-2.0-flash"

]


def query_perplexity(prompt, model="sonar-medium-online"):
    headers = {
        "Authorization": f"Bearer {API_KEY}",
        "Content-Type": "application/json"
    }
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 500,
        "temperature": 0.7
    }
    try:
        response = requests.post(API_URL, json=payload, headers=headers)
        response.raise_for_status()
        return response.json()["choices"][0]["message"]["content"]
    except Exception as e:
        return f"{Fore.RED}Error: {str(e)}{Style.RESET_ALL}"

def main():
    colorama.init(autoreset=True)
    parser = argparse.ArgumentParser(description="Perplexity CLI agent by naelmohammad at gmail dotcom")
    parser.add_argument(
        "-m", "--model",
        default="sonar-medium-online",
        choices=MODELS,
        help="Model to use (default: sonar-medium-online)"
    )
    parser.add_argument(
        "query",
        nargs="+",
        help="Your search query (no quotes needed)"
    )

    argcomplete.autocomplete(parser)
    args = parser.parse_args()
    prompt = " ".join(args.query)
    print(Fore.CYAN + Style.BRIGHT + "Querying Perplexity..." + Style.RESET_ALL)
    result = query_perplexity(prompt, args.model)
    print(Fore.GREEN + Style.BRIGHT + "\nResult:\n" + Style.RESET_ALL + result + "\n")

if __name__ == "__main__":
    main()
